# ── Static site (frontend) ──
# Base URL of the API server that handles form submissions.
# Leave empty when running the API on the same origin (dev mode).
NEXT_PUBLIC_API_URL=

# Base URL of the onboarding app, e.g. https://app.chatbot.om
# LEAVE EMPTY to keep the site concierge-only: the "Set it up yourself" link on
# /get-started/ renders ONLY when this is set. Setting it publishes a self-serve
# path that needs an account, which sits alongside the "No account needed"
# promise on that page — read the note above `selfServeUrl` in src/data/site.ts
# before switching it on.
NEXT_PUBLIC_APP_URL=

# ── API server (backend) ──
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=system-emails@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=system-emails@example.com
CTA_OWNER_EMAILS=contact@inzint.om
